# ─────────────────────────────────────────────────────────────────────────────
# NIRBHED — standalone agent mode configuration (API-key path).
# MCP server mode (Claude Desktop) does NOT read this file and needs no API key.
# Copy to .env and edit. Anything here can also be passed via CLI flags.
# ─────────────────────────────────────────────────────────────────────────────

# Primary LLM provider. Any OpenAI-compatible endpoint works:
# DeepSeek, OpenAI, OpenRouter, Together, Groq, local Ollama, or Anthropic's
# OpenAI-compatible endpoint. Point base_url + model at whatever is cheapest.
NIRBHED_API_KEY=sk-your-key
NIRBHED_BASE_URL=https://api.deepseek.com
NIRBHED_MODEL=deepseek-chat

# Optional failover provider (used automatically if the primary errors/ratelimits).
# Example: fall back to a Claude key when your DeepSeek quota is exhausted.
NIRBHED_FALLBACK_API_KEY=
NIRBHED_FALLBACK_BASE_URL=https://api.anthropic.com/v1
NIRBHED_FALLBACK_MODEL=claude-haiku-4-5

# Budgets — hard caps so a run can never silently burn tokens/money.
NIRBHED_MAX_TOKENS=120000      # total prompt+completion tokens for the whole run
NIRBHED_MAX_TURNS=40           # max planner/worker iterations
NIRBHED_MAX_SECONDS=1800       # wall-clock cap

# Token frugality — raw tool output is distilled before it ever reaches the LLM.
NIRBHED_DISTILL_MAX_CHARS=2000 # hard cap on a single observation fed to the model
NIRBHED_CACHE=1                # 1 = reuse identical tool invocations (0 tokens, 0 re-run)

# Authenticated testing (optional). These let the agent hit logged-in surface.
# Secrets are applied at the HTTP layer + exposed to PoCs as env vars; they are
# NOT shown to the LLM. You can also set these per-run with --cookie/--bearer/-H,
# or inject them live from the dashboard mid-engagement.
NIRBHED_COOKIE=                # e.g. session=abc123; csrf=xyz
NIRBHED_BEARER=                # JWT / OAuth token WITHOUT the 'Bearer ' prefix
NIRBHED_BASIC=                 # user:pass for HTTP basic auth
NIRBHED_HEADERS=               # extra headers, 'Key: Value' one per line
